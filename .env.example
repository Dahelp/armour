APP_ENV=production
APP_DEBUG=0
APP_URL=https://techtires.ru

DB_HOST=127.0.0.1:3306
DB_DATABASE=techtires
DB_USERNAME=techtires
DB_PASSWORD=change-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_PROTOCOL=tls
SMTP_USERNAME=info@techtires.ru
SMTP_PASSWORD=change-me

FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USERNAME=techtires
FTP_PASSWORD=change-me

# Long random value used by external schedulers in X-Cron-Token.
CRON_TOKEN=change-me-to-a-long-random-token

# Enable only after the SQL migration and old-to-new URL map are loaded.
LEGACY_REDIRECTS_ENABLED=0
LEGACY_REDIRECT_BASE_URL=https://techtires.ru
